#!/bin/sh
set -eu

usage() {
    printf 'Usage: ./koke apply [Name[@Version]] [Gradle options]\n'
    printf 'Without a name, creates missing modules from base profiles.\n'
}

case "${1-}" in
    ''|-h|--help) usage; exit 0 ;;
    apply) shift ;;
    *) usage >&2; exit 2 ;;
esac

case "${1-}" in
    -h|--help) usage; exit 0 ;;
    ''|-*) ;;
    *) module=$1; shift; set -- "-Pmodule=$module" "$@" ;;
esac

cd -- "$(dirname -- "$0")"
exec ./gradlew apply "$@"
